# Firebase Web SDK config (get from Firebase Console > Project Settings > Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Server-only secrets. NEVER prefix these with NEXT_PUBLIC_. ───

# Firebase Admin SDK (Firebase Console > Project Settings > Service Accounts >
# Generate new private key). Keep the surrounding quotes: the key contains
# literal \n sequences that the app converts back to real newlines.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

# CHIP Collect (portal.chip-in.asia > Developers). Use test-mode keys until
# you have tested end to end; a test key returns `is_test: true` on purchases.
#
# Note: CHIP rejects callback URLs with a custom port — only 80/443. Local
# testing therefore needs a public HTTPS tunnel (e.g. ngrok/cloudflared)
# rather than localhost:3000.
CHIP_SECRET_KEY=your_chip_secret_key
CHIP_BRAND_ID=your_chip_brand_id

# Required in local dev only. CHIP's success_callback is rejected outright on
# any non-80/443 port, which localhost:3000 always is. Point this at a public
# HTTPS tunnel (`ngrok http 3000`, then paste its https://...ngrok-free.app
# URL here) so checkout can actually receive payment confirmations. Not
# needed in production, where the app's real origin already uses 443.
CHIP_CALLBACK_ORIGIN=https://your-tunnel-url.ngrok-free.app
