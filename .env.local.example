# Firebase Web SDK config (get from Firebase Console > Project Settings > Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Server-only secrets. NEVER prefix these with NEXT_PUBLIC_. ───

# Firebase Admin SDK (Firebase Console > Project Settings > Service Accounts >
# Generate new private key). Keep the surrounding quotes: the key contains
# literal \n sequences that the app converts back to real newlines.
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

# Stripe (Developers > API keys). Use sk_test_ keys until you've tested
# end-to-end. Required for Connect onboarding.
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Stripe webhook signing secret. Until this is set, viewer checkout is
# refused with a 503 — credits are granted by the webhook, so taking a
# payment without it would charge the viewer and deliver nothing.
#
# Create the endpoint at
# Developers > Webhooks pointing to /api/webhooks/stripe, and set
# "Events from" to **Connected accounts** — MabarQueue uses direct charges,
# so payment events originate on the streamer's account, not the platform's.
# Events to select: checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, account.updated
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Publishable key is browser-safe by design (Stripe.js requires it).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
